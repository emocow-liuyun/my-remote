{
  "name": "@local/my-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 桌面端自建远程访问：本机固定密码 + 设备会话 + 门控 /myremote 通道，自建 Cloudflare 隧道，不做第三方中继。",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./settings": "./settings/index.js",
    "./settings/client": "./settings/client.js",
    "./settings/locale/*.json": "./settings/locale/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "settings",
    "bin",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings"],
      "external": ["react"]
    }
  },
  "bin": {
    "myremote-entry": "bin/fixed-entry.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-access",
    "cloudflare-tunnel"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
